# GEMINI_API_KEY: Required if Gemini AI API calls are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC-SHA256 secret for signing authentication tokens in memory.
SESSION_SECRET="REPLACE_WITH_RANDOM_64_CHAR_HEX_SECRET"

# ADMIN_PASSCODE: Server-side passcode required to unlock Admin Console access.
# If left empty on first run, the first-run Admin Claim flow allows configuring an admin passphrase.
ADMIN_PASSCODE=""

# TRC20_WALLET_ADDRESS: Merchant USDT (TRC-20) settlement address served by the backend.
TRC20_WALLET_ADDRESS=""

# TRC20_NETWORK: Display network label for settlement checkout.
TRC20_NETWORK="Tron TRC-20"

# TRONGRID_API_KEY: Optional TronGrid Pro API key for higher rate-limit on-chain verification.
TRONGRID_API_KEY=""
